name = "flash-game-platform"
compatibility_date = "2024-01-01"
main = "src/index.js"

# 静态资源配置
[site]
bucket = "./public"

# D1 数据库配置
[[d1_databases]]
binding = "DB"
database_name = "flash_games_db"
database_id = "your-database-id-here"

# R2 存储桶配置
[[r2_buckets]]
binding = "FLASH_STORAGE"
bucket_name = "flash-games"
preview_bucket_name = "flash-games"

# KV 命名空间配置（频率限制）
[[kv_namespaces]]
binding = "RATE_LIMIT"
id = "your-kv-id-here"
preview_id = "your-preview-kv-id-here"

# 环境变量
[vars]
# 超级管理员密码（建议使用强密码）
ADMIN_PASSWORD = "your-secure-password-here"

# R2 自定义域名（推荐使用自定义域，而非公共 URL）
R2_PUBLIC_URL = "https://your-r2-custom-domain.com"

# JWT 密钥（用于签名 Token，建议使用 64 字符随机字符串）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET = "your-random-64-char-secret-here"
